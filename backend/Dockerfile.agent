FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    ffmpeg \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.lock.txt .

RUN pip install --no-cache-dir -r requirements.lock.txt

COPY . .

CMD ["python", "-m", "agent.agent", "dev"]
